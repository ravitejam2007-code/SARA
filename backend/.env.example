# Zenith AI — Sovereign Industrial AI Workbench
# Backend Environment Configuration

# Server Environment
PROJECT_NAME="Zenith AI — Sovereign Industrial AI Workbench"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration
# For PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/zenith_db
# For SQLite (Dev Fallback): sqlite:///./zenith_dev.db
DATABASE_URL="sqlite:///./zenith_dev.db"

# Security & JWT Secrets (Change in Production!)
SECRET_KEY="zenith_sovereign_dev_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage Path for Uploaded Engineering Documents & Artifacts
STORAGE_DIR="./storage"
